# ── Autonomic Anxiety Guide — Environment Variables ──────────────────────────
# Copy this file to .env and fill in your values. NEVER commit .env to git.

# Flask
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-string

# Anthropic (get your key at console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Database (SQLite used by default in development)
# For production, use PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/anxiety_guide

# CORS — comma-separated list of allowed frontend origins
# Development: leave as * or set to your React dev server
# Production: set to your deployed frontend URL
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
